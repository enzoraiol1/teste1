generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Case {
  id          String   @id @default(cuid())
  title       String
  modality    String
  region      String
  difficulty  String   @default("medio")
  findings    String
  diagnosis   String
  pearls      String?
  tags        String   @default("[]")
  imageUrl    String?
  source      String?
  sourceUrl   String?
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flashcards  Flashcard[]
  studyLogs   StudyLog[]
}

model Report {
  id          String   @id @default(cuid())
  title       String
  modality    String
  region      String
  template    String
  content     String
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Flashcard {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String
  tags        String   @default("[]")
  difficulty  String   @default("medio")
  nextReview  DateTime @default(now())
  interval    Int      @default(1)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudyLog {
  id        String   @id @default(cuid())
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  type      String
  score     Int?
  duration  Int?
  notes     String?
  date      DateTime @default(now())
}
